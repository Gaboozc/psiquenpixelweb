# ── Supabase (Dashboard → Project Settings → API) ───────────────────────────
# Project URL: solo el dominio, sin barra final ni /rest/v1
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Secret key (sb_secret_… o service_role). SOLO servidor. Nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_… o anon). Segura de exponer; se usa para el login.
SUPABASE_PUBLISHABLE_KEY=

# ── Admin ───────────────────────────────────────────────────────────────────
# Emails con acceso al panel (separados por comas). Sin esto NADIE puede entrar,
# aunque exista como usuario en Supabase.
ADMIN_EMAILS=tu@email.com
# Opcional: clave para firmar la sesión. Si no se define se deriva de
# SUPABASE_SERVICE_ROLE_KEY.
# ADMIN_SECRET=
